import shap
import numpy as np
import pandas as pd
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA

# Load original data and scale it
protein_df_original = pd.read_csv("protein_embeddings_4.csv", index_col=0)
X_original = protein_df_original.values
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X_original)

# Ensure X_scaled is filtered to match the filtered protein_df
filtered_indices = protein_df.index
original_indices = pd.Index(pd.read_csv("protein_embeddings_4.csv", index_col=0).index)
rows_to_keep = original_indices.get_indexer(filtered_indices)
X_scaled_filtered = X_scaled[rows_to_keep]

# Re-calculate SHAP values using the original scaled data for plotting original dimensions
# Assuming 'model' is already trained on the PCA-transformed data X_train
# We need an explainer that can work with the original features.
# Since the model was trained on PCA features, we need a way to map original features to PCA features for the explainer.
# A common way is to use a KernelExplainer with a background dataset transformed by PCA.
# However, a simpler approach for visualization purposes with dependence plots on original features
# is to create an explainer for the original features and the trained model. This might not be theoretically
# perfect as the model wasn't directly trained on original features, but can provide insights.

# Let's use a sample of the original scaled data as the background dataset for KernelExplainer
# Note: This can still be computationally intensive
background_data = shap.utils.sample(X_scaled_filtered, 50) # Sample 50 data points as background

# Use the existing model trained on PCA features
# We need a function that takes original features and outputs the model's prediction
def predict_on_original(x):
    # Apply the same scaling and PCA transformation as done during training
    x_scaled = scaler.transform(x)
    x_pca = pca.transform(x_scaled)
    return model.predict(x_pca)

# Create a Kernel explainer with the original scaled data and the prediction function
explainer_original_dims = shap.KernelExplainer(predict_on_original, background_data)

# Calculate SHAP values for the original scaled data
# Note: This can take a significant amount of time depending on the size of X_scaled_filtered
print("Calculating SHAP values for original dimensions...")
shap_values_original_dims = explainer_original_dims.shap_values(X_scaled_filtered, nsamples=100)
print("SHAP value calculation complete.")

# Ensure shap_values_original_dims is a numpy array with the correct shape for plotting
# For a single output model, shap_values typically returns a list containing one array.
# We need to access this array and ensure it's treated as a numpy array with shape (n_samples, n_features).
if isinstance(shap_values_original_dims, list) and len(shap_values_original_dims) == 1:
    shap_values_for_plot = np.asarray(shap_values_original_dims[0])
else:
    # If it's not a list of one array, assume it's already the array, but convert to numpy
    shap_values_for_plot = np.asarray(shap_values_original_dims)

# The selected_dims are for the original embedding dimensions.
selected_dims = [89, 272, 5, 262, 280, 216, 206, 146, 124, 150]

# Plot dependence plots for the selected original dimensions
feature_names_original = [f'Dim_{i}' for i in range(X_scaled_filtered.shape[1])]

for dim_index in selected_dims:
     shap.dependence_plot(
        dim_index,
        shap_values_for_plot, # Use the prepared SHAP values array
        X_scaled_filtered,
        feature_names=feature_names_original,
        interaction_index=None # Explicitly set interaction_index to None
    )


